    "You can sign in to save your favorite routes and receive personalized notifications. " : {
      "comment" : "OnboardingSignInView.swift",
      "extractionState" : "manual",
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να συνδεθείτε για να αποθηκεύσετε τις αγαπημένες σας διαδρομές και να λαμβάνετε εξατομικευμένες ειδοποιήσεις."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете войти в систему, чтобы сохранять любимые маршруты и получать персонализированные уведомления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете увійти в систему, щоб зберігати улюблені маршрути та отримувати персоналізовані сповіщення."
          }
