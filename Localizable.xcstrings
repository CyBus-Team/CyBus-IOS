    "Location data is currently unavailable. You must enable location services in your device settings." : {
      "comment" : "Error shown when location data is not accessible",
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα τοποθεσίας δεν είναι διαθέσιμα αυτή τη στιγμή. Πρέπει να ενεργοποιήσετε τις υπηρεσίες τοποθεσίας στις ρυθμίσεις της συσκευής σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location data is currently unavailable. You must enable location services in your device settings."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location data is currently unavailable. You must enable location services in your device settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные о местоположении в данный момент недоступны. Необходимо включить службы геолокации в настройках устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані про місцезнаходження наразі недоступні. Потрібно увімкнути служби геолокації в налаштуваннях пристрою."
          }
        }
      }
    },
    "Location permission was denied. You must enable location services in your device settings." : {
      "comment" : "Error shown when location permission is denied",
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η άδεια τοποθεσίας απορρίφθηκε. Πρέπει να ενεργοποιήσετε τις υπηρεσίες τοποθεσίας στις ρυθμίσεις της συσκευής σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission was denied. You must enable location services in your device settings."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location permission was denied. You must enable location services in your device settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к местоположению был отклонен. Необходимо включить службы геолокации в настройках устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до місцезнаходження був відхилений. Потрібно увімкнути служби геолокації в налаштуваннях пристрою."
          }
        }
      }
    },
