      }
    },
    "To show you your current location and the nearest buses, we need access to your geolocation." : {
      "comment" : "OnboardingGeolocationView",
      "extractionState" : "manual",
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να σας δείξουμε την τρέχουσα τοποθεσία σας και τα πλησιέστερα λεωφορεία, χρειαζόμαστε πρόσβαση στην τοποθεσία σας."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы показать ваше текущее местоположение и ближайшие автобусы, нам нужен доступ к вашей геолокации."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб показати ваше поточне місцезнаходження та найближчі автобуси, нам потрібен доступ до вашої геолокації."
          }
        }
      }
    },
    "Track buses in real time, plan routes and add your favorite stops to your favorites." : {
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθήστε τα λεωφορεία σε πραγματικό χρόνο, σχεδιάστε διαδρομές και προσθέστε τις αγαπημένες σας στάσεις στα αγαπημένα σας."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживайте автобусы в реальном времени, \nпланируйте маршруты и добавляйте любимые остановки в избранное."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежуйте автобуси в реальному часі, плануйте маршрути та додавайте улюблені зупинки до вибраного."
          }
        }
      }
    },
    "Type your destination..." : {
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολογήστε τον προορισμό σας…"
