    "Log in for more convenient use" : {
      "comment" : "OnboardingSignInView",
      "extractionState" : "manual",
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε για πιο εύκολη χρήση"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
