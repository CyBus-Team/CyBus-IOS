    "No trips found. There might not be any available buses at the moment. Please also make sure location access is enabled in your settings so we can find the best options near you." : {
      "localizations" : {
        "el-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκαν δρομολόγια. Ίσως να μην υπάρχουν διαθέσιμα λεωφορεία αυτή τη στιγμή. Παρακαλούμε βεβαιωθείτε ότι η πρόσβαση στην τοποθεσία είναι ενεργοποιημένη στις ρυθμίσεις της συσκευής σας, ώστε να μπορούμε να σας δείξουμε τις καλύτερες επιλογές κοντά σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No trips found. There might not be any available buses at the moment. Please also make sure location access is enabled in your settings so we can find the best options near you."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No trips found. There might not be any available buses at the moment. Please also make sure location access is enabled in your settings so we can find the best options near you."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршруты не найдены. Возможно, в данный момент нет доступных автобусов. Пожалуйста, также убедитесь, что в настройках устройства включён доступ к геолокации - это поможет нам найти лучшие варианты рядом с вами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрути не знайдені. Можливо, зараз немає доступних автобусів. Будь ласка, переконайтеся, що в налаштуваннях пристрою увімкнено доступ до геолокації — це допоможе нам знайти найкращі варіанти поруч з вами."
          }
        }
      }
    },
